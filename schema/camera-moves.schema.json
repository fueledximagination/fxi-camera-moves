{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fueledximagination/fxi-camera-moves/schema/camera-moves.schema.json",
  "title": "AI video camera movement prompt recipes",
  "description": "One record per camera movement: a ready-to-paste prompt recipe for image-to-video and text-to-video models, with tips, negatives, a recommended clip length, and an example clip.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "category",
      "description",
      "prompt",
      "prompt_template",
      "best_for",
      "tips",
      "negatives",
      "recommended_duration_min_s",
      "recommended_duration_max_s",
      "dramatic",
      "example_clip_url",
      "example_clip_webm_url",
      "poster_url",
      "example_clip_duration_s",
      "example_clip_width",
      "example_clip_height",
      "tutorial_url"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Stable kebab-case identifier. Never changes once published.",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": { "type": "string", "minLength": 1, "description": "Display name." },
      "category": {
        "type": "string",
        "enum": ["Pan/Tilt", "Zoom/Lens", "Dolly/Track", "Physical Moves", "Human Camera", "Drone/Crane", "Specials"]
      },
      "description": { "type": "string", "minLength": 1, "description": "One-line description of the move." },
      "prompt": {
        "type": "string",
        "minLength": 20,
        "description": "The recipe: Movement / Speed / Framing / End, ready to paste after a scene description."
      },
      "prompt_template": {
        "type": "string",
        "pattern": "^\\{scene\\}\\. Camera: ",
        "description": "Full prompt with a {scene} placeholder for your subject and setting."
      },
      "best_for": { "type": "string", "minLength": 1, "description": "When the move works best." },
      "tips": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 },
        "description": "Practical advice for getting the move to land."
      },
      "negatives": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 },
        "description": "Competing motions to rule out, for models that accept a negative prompt."
      },
      "recommended_duration_min_s": { "type": "number", "minimum": 1, "maximum": 20 },
      "recommended_duration_max_s": { "type": "number", "minimum": 1, "maximum": 20 },
      "dramatic": { "type": "boolean", "description": "Visually dynamic move." },
      "example_clip_url": { "type": "string", "pattern": "^https://assets\\.fxi\\.studio/.+\\.mp4$" },
      "example_clip_webm_url": { "type": "string", "pattern": "^https://assets\\.fxi\\.studio/.+\\.webm$" },
      "poster_url": { "type": "string", "pattern": "^https://assets\\.fxi\\.studio/.+\\.jpg$" },
      "example_clip_duration_s": { "type": "number", "minimum": 0.5, "maximum": 60 },
      "example_clip_width": { "type": "integer", "minimum": 16 },
      "example_clip_height": { "type": "integer", "minimum": 16 },
      "tutorial_url": {
        "type": "string",
        "pattern": "^https://www\\.fxi\\.studio/tutorials/prompt-recipes/[a-z0-9-]+\\?utm_source=github&utm_medium=oss&utm_campaign=camera-moves&utm_content=dataset$"
      }
    }
  }
}
